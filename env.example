MEDUSA_BASE_URL=http://localhost:9000

# Medusa Admin authentication.
# api-key: Authorization: Basic <MEDUSA_API_KEY>
# jwt: Authorization: Bearer <MEDUSA_JWT or MEDUSA_API_KEY>
# session: Cookie: <MEDUSA_SESSION_COOKIE>
MEDUSA_AUTH_TYPE=api-key
MEDUSA_API_KEY=your_admin_api_key_or_secret_token
MEDUSA_API_KEY_BASE64=false
MEDUSA_JWT=
MEDUSA_SESSION_COOKIE=

# Required only for remote HTTP MCP access.
MCP_AUTH_TOKEN=replace_with_a_strong_token
PORT=3000
